# ==============================================================================
# KINDRED CUSTOMER MESSAGING — COST-EFFECTIVE API CONFIGURATION
# ==============================================================================
# IMPORTANT:
# - NEVER commit your actual .env file or credentials to git.
# - Set these environment variables in your Vercel Project Settings:
#   https://vercel.com/dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY CARRIER: TELNYX API (HIGHLY COST-EFFECTIVE: ~$0.0040/SMS, ~45% SAVINGS)
# ------------------------------------------------------------------------------
# From your Telnyx Portal (https://portal.telnyx.com):
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_FROM_NUMBER=+1xxxxxxxxxx
TELNYX_MESSAGING_PROFILE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# TELNYX_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (optional webhook verification)

# ------------------------------------------------------------------------------
# 2. ALTERNATIVE CARRIER: TWILIO API (OPTIONAL FALLBACK)
# ------------------------------------------------------------------------------
# If you prefer Twilio or want carrier redundancy:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. AI ASSISTANT: GOOGLE GEMINI 2.0 / 1.5 FLASH (FREE TIER: 1,500 REQ/DAY)
# ------------------------------------------------------------------------------
# Powers Two-Way Inbox Smart Replies, Intent Classification & Mortgage Copilot.
# 100% Free tier available at Google AI Studio: https://aistudio.google.com/app/apikey
# Paid tier is only $0.075 / 1M input tokens (~97% cheaper than OpenAI GPT-4o).
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. LIVE MORTGAGE RATES: FRED API (FEDERAL RESERVE BANK - 100% FREE)
# ------------------------------------------------------------------------------
# Provides official Freddie Mac 30-Year & 15-Year benchmark series (MORTGAGE30US).
# Free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. PERSISTENT STORAGE: UPSTASH REDIS / VERCEL KV (100% FREE TIER: 10,000 CMD/DAY)
# ------------------------------------------------------------------------------
# For serverless multi-instance persistence (message logs, suppressions, rate limits).
# Connect free Upstash Redis via Vercel Integrations or https://console.upstash.com:
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxx...
# Or Vercel KV:
# KV_REST_API_URL=https://xxxx.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxxxxx...

# ------------------------------------------------------------------------------
# 6. TEST MODE SAFETY ALLOWLIST (MANDATORY FOR TEST DISPATCH)
# ------------------------------------------------------------------------------
# Comma-separated list of approved US recipient numbers in E.164 format (+1XXXXXXXXXX).
# In test mode, /api/send-sms strictly blocks sending to any number NOT in this list.
TEST_ALLOWED_NUMBERS=+12025550143,+14155552671

# ------------------------------------------------------------------------------
# 7. APPLICATION BASE URL (FOR DELIVERY WEBHOOKS)
# ------------------------------------------------------------------------------
# Your deployed Vercel domain (without trailing slash).
# Used by carriers to report delivery receipts (queued -> sent -> delivered / failed).
APP_BASE_URL=https://kindred-messaging.vercel.app

# ------------------------------------------------------------------------------
# 8. DAILY SPEND / SEND CAP SAFETY LIMIT
# ------------------------------------------------------------------------------
# Maximum test SMS messages allowed per day across the application (default: 50)
DAILY_SEND_CAP=50
