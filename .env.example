# ==============================================================================
# KINDRED CUSTOMER MESSAGING — ENVIRONMENT CONFIGURATION (TWILIO SMS TEST MODE)
# ==============================================================================
# IMPORTANT:
# - NEVER commit your actual .env file or credentials to git.
# - Set these environment variables in your Vercel Project Settings:
#   https://vercel.com/dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TWILIO API CREDENTIALS
# ------------------------------------------------------------------------------
# From your Twilio Console (https://console.twilio.com):
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ------------------------------------------------------------------------------
# 2. TWILIO PHONE NUMBER OR MESSAGING SERVICE
# ------------------------------------------------------------------------------
# Either a Twilio Toll-Free or 10DLC number in E.164 format (e.g. +18005550199)
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# OR your Twilio Messaging Service SID (MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx):
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. TEST MODE SAFETY ALLOWLIST (MANDATORY)
# ------------------------------------------------------------------------------
# Comma-separated list of approved US recipient numbers in E.164 format (+1XXXXXXXXXX).
# In test mode, /api/send-sms strictly blocks sending to any number NOT in this list.
TEST_ALLOWED_NUMBERS=+12025550143,+14155552671

# ------------------------------------------------------------------------------
# 4. APPLICATION BASE URL (FOR TWILIO WEBHOOK STATUS CALLBACKS)
# ------------------------------------------------------------------------------
# Your deployed Vercel domain (without trailing slash).
# Used by Twilio to report delivery status (queued -> sent -> delivered / failed).
APP_BASE_URL=https://kindred-messaging.vercel.app

# ------------------------------------------------------------------------------
# 5. SAFETY LIMITS & RATE LIMITS
# ------------------------------------------------------------------------------
# Maximum test SMS messages allowed per day across the application (default: 50)
DAILY_SEND_CAP=50

# ------------------------------------------------------------------------------
# 6. PERSISTENT STORAGE (OPTIONAL — FOR VERCEL SERVERLESS PERSISTENCE)
# ------------------------------------------------------------------------------
# By default, an in-memory store is used. For multi-region serverless persistence
# across lambdas, connect Upstash Redis or Vercel KV from Vercel Marketplace:
#
# Upstash Redis REST credentials (https://console.upstash.com):
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxx...
#
# Vercel KV REST credentials (if using Vercel KV integration):
# KV_REST_API_URL=https://xxxx.kv.vercel-storage.com
# KV_REST_API_TOKEN=xxxxxx...
